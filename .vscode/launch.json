{
    // Run whole scripts top-to-bottom (Sullivan 5.2: never run snippets)
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run current script (repo root)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "C:/Users/ValerieFranchitti/.anaconda-desktop/micromamba/envs/cpu/envs/chicago/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "console": "integratedTerminal"
        },
        {
            "name": "Run Model 1 (knowledge-based score)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.run_model_knowledge_score",
            "python": "C:/Users/ValerieFranchitti/.anaconda-desktop/micromamba/envs/cpu/envs/chicago/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
