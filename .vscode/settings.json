{
    // Use the project's conda env (built from environment.yml) directly.
    // conda itself is not on PATH (Anaconda Desktop), so VS Code must not
    // try to "activate" the env in terminals; it calls this python.exe.
    "python.defaultInterpreterPath": "C:/Users/ValerieFranchitti/.anaconda-desktop/micromamba/envs/cpu/envs/chicago/python.exe",
    "python.terminal.activateEnvironment": false,
    "python.condaPath": "C:/Users/ValerieFranchitti/.anaconda-desktop/micromamba/envs/cpu/Scripts/conda.exe",

    // Run scripts from the repo root so src/config.py paths resolve
    "python.terminal.executeInFileDir": false,
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    "python.analysis.extraPaths": ["${workspaceFolder}"],

    // PEP8 (Sullivan best practices): 79-char lines, flake8 linting
    "editor.rulers": [79],
    "flake8.args": ["--max-line-length=79"],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
